  nube: '<path d="M7 18.5h10.5a4 4 0 0 0 .5-8 6 6 0 0 0-11.6 1.5A3.3 3.3 0 0 0 7 18.5z"/><path d="M12 15.5v-5M9.8 12.7L12 10.5l2.2 2.2"/>',
